<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080B18"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="FIREGUARD"
            android:textColor="#FF9F43"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="System Information"
            android:textColor="#FFFFFF"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Learn about FireGuard and its fire safety monitoring features."
            android:textColor="#AAB4CC"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <!-- About FireGuard -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#151D32"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ABOUT FIREGUARD"
                android:textColor="#FF9F43"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="FireGuard is a fire safety monitoring application designed to display room conditions, identify potential risks, and present safety information through a simple and user-friendly dashboard."
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:lineSpacingExtra="5dp" />

        </LinearLayout>

        <!-- Monitoring Features -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#151D32"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MONITORING FEATURES"
                android:textColor="#FF9F43"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="• Room temperature monitoring&#10;&#10;• Smoke detection status&#10;&#10;• Safe and danger indicators&#10;&#10;• Safety alerts and warnings&#10;&#10;• Monitoring of three sample rooms&#10;&#10;• Safety check history and status summaries"
                android:textColor="#D7DEEF"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

        <!-- Important Information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#252039"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="IMPORTANT INFORMATION"
                android:textColor="#D6B2FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="FireGuard currently uses simulated readings for demonstration and testing purposes. No physical temperature or smoke sensors are connected to the application.&#10;&#10;This application is intended for educational and demonstration purposes only. It is not a substitute for certified fire alarms, smoke detectors, or other approved fire safety and emergency equipment."
                android:textColor="#E1D9F0"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:padding="10dp"
            android:text="FIREGUARD • SMART SAFETY MONITORING"
            android:textColor="#8995AF"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
